{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "off",
        "noUnusedTemplateLiteral": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.css",
      "!**/dist",
      "!**/node_modules",
      "!**/data",
      "!site",
      "!**/*.gen.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "app/src/components/ui/**",
        "app/src/components/action-button.tsx",
        "app/src/components/app-form.tsx",
        "app/src/components/card-layout.tsx",
        "app/src/components/confirm-button.tsx",
        "app/src/components/dialog-layout.tsx",
        "app/src/components/field-row.tsx",
        "app/src/components/form-field.tsx",
        "app/src/components/header-content-footer.tsx",
        "app/src/components/option-select.tsx",
        "app/src/components/page-header.tsx",
        "app/src/components/page-layout.tsx",
        "app/src/components/password-input.tsx",
        "app/src/components/query-state.tsx",
        "app/src/components/section.tsx"
      ],
      "linter": {
        "enabled": false
      }
    }
  ]
}
